# 함뜨까 환경 변수 예시
#
# 이 파일에는 변수 이름만 적는다. 실제 값은 커밋하지 않는다 (헌법 P-10).
# 로컬 개발: 이 파일을 apps/web/.env.local로 복사한 뒤, `pnpm db:status`가
# 출력하는 값을 채운다. Vercel 배포: 프로젝트 설정의 Environment Variables에
# 서울 리전 Supabase 프로젝트의 값을 넣는다.

# Supabase API 주소. 로컬 스택은 http://127.0.0.1:54321 이다.
# `pnpm db:status` 출력의 API_URL.
NEXT_PUBLIC_SUPABASE_URL=

# 브라우저에 공개해도 되는 키(sb_publishable_...). RLS가 권한을 검사한다.
# `pnpm db:status` 출력의 PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RLS를 거치지 않는 서버 전용 키(sb_secret_...). 예전 service-role 키를 대신한다.
# 서버에서 실행되는 코드에서만 읽고, NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# `pnpm db:status` 출력의 SECRET_KEY.
SUPABASE_SECRET_KEY=
