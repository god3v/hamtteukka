{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // apps/web의 Node 내장 테스트 러너가 이 패키지를 TypeScript 소스 그대로 읽으므로, 상대 경로 import에 .ts를 붙인다.
    "allowImportingTsExtensions": true,
    // Supabase 접속 정보를 process.env에서 읽는다. 브라우저 번들에서는 Next.js가 NEXT_PUBLIC_ 값을 바꿔 넣는다.
    "types": ["node"]
  },
  "include": ["src"]
}
